    {
      "id": "exception_disposition",
      "scenario": "exception-disposition",
      "description": "Provides handled, VEH-continued first-chance and deliberately unhandled exception paths.",
      "safety": {
        "classification": "benign",
        "requiresAdmin": false,
        "network": false,
        "dangerous": false,
        "sideEffects": ["raises-process-local-exception", "may-create-local-crash-report"]
      },
      "build": {
        "kind": "exe",
        "language": "c",
        "architectures": ["x86", "x64"],
        "sources": ["tests/fixtures/e2e/exception_disposition.c"],
        "output": "tools/bin/e2e/{arch}/exception_disposition.exe"
      },
      "runtime": [
        {
          "name": "handled-seh",
          "args": ["handled"],
          "expectedExitCode": 0,
          "stdoutContains": ["EXCEPTION_OK mode=handled", "firstChance=1", "sehHandled=1"],
          "timeoutSeconds": 5
        },
        {
          "name": "first-chance-veh-continue",
          "args": ["first-chance"],
          "expectedExitCode": 0,
          "stdoutContains": ["EXCEPTION_OK mode=first-chance", "firstChance=1", "vehContinued=1"],
          "timeoutSeconds": 5
        },
        {
          "name": "managed-clr-shaped-exception",
          "args": ["managed"],
          "expectedExitCode": 0,
          "stdoutContains": [
            "MANAGED_EXCEPTION_OK code=0xE0434352",
            "hresult=0x80131500",
            "caught=1"
          ],
          "timeoutSeconds": 5
        },
        {
          "name": "unhandled-second-chance",
          "args": ["unhandled"],
          "expectedExitCode": 3762438722,
          "stdoutContains": ["EXCEPTION_EVENT mode=unhandled", "code=0xE0424242"],
          "allowCrash": true,
          "timeoutSeconds": 5
        },
        {
          "name": "policy-precedence-sequence",
          "args": ["policy-sequence"],
          "expectedExitCode": 0,
          "stdoutContains": [
            "EXCEPTION_SEQUENCE selector=exact code=0xE0424242 caught=1",
            "EXCEPTION_SEQUENCE selector=masked code=0xE0429999 caught=1",
            "EXCEPTION_SEQUENCE selector=wildcard code=0xA1234567 caught=1",
            "EXCEPTION_POLICY_OK exact=1 masked=1 wildcard=1 caught=3"
          ],
          "timeoutSeconds": 5
        }
      ]
    },
